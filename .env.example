# Copy this file to .env and fill it in. .env is git-ignored; keep it private.

# Email finder (hunter.io → API keys)
HUNTER_API_KEY=

# Sending (flow/send.md, option A). For Gmail: an app password, not your normal password.
MAIL_ADDRESS=
MAIL_APP_PASSWORD=
# Only for non-Gmail providers:
# SMTP_HOST=
# SMTP_PORT=
