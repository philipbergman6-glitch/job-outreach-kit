# Copy this file to .env and fill it in. .env is git-ignored; keep it private.
# One KEY=value per line, nothing else on the line. Every key is optional except the two
# sending keys on send path A (flow/send.md).

# Sending (flow/send.md, option A). For Gmail: an app password, not your normal password.
MAIL_ADDRESS=
MAIL_APP_PASSWORD=
# Only for non-Gmail providers:
# SMTP_HOST=
# SMTP_PORT=

# Email finders: none is required (scripts/emails.py works without any). Each adds reach,
# free up to a monthly limit. `python3 scripts/emails.py providers` shows what is left.
PROSPEO_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=
TOMBA_API_KEY=
TOMBA_API_SECRET=
ANYMAILFINDER_API_KEY=
FINDYMAIL_API_KEY=

# Optional semantic search for people and companies (scripts/search.py).
EXA_API_KEY=
BRAVE_API_KEY=

# Optional: raises GitHub's limit for `emails.py github` from 60 to 5,000 requests an hour.
GITHUB_TOKEN=
